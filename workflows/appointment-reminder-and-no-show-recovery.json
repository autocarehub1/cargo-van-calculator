{
  "name": "Appointment Reminder + No-Show Recovery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "50ef5eb7-5fd9-4df2-b6ba-25def9a3b107",
      "name": "Hourly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -980,
        80
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "baseId": "={{$credentials.airtableApi.baseId}}",
        "tableId": "Appointments",
        "filterByFormula": "=AND({StartTime}>=NOW(), {StartTime}<=DATEADD(NOW(), 24, 'hours'), {ReminderSent}='No')"
      },
      "id": "d6341d02-9fd8-4ad1-b27a-42a5fce39ea2",
      "name": "Find Upcoming Appointments",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        -720,
        -40
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "={{$credentials.twilioApi.fromNumber}}",
        "to": "={{$json[\"Phone\"]}}",
        "message": "Reminder: You have an appointment at {{$json[\"BusinessName\"]}} on {{$json[\"StartTime\"]}}. Reply C to confirm or R to reschedule."
      },
      "id": "ee12de7e-e81c-4bf8-9d6d-dcfecf2af4d0",
      "name": "Send Reminder SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 2,
      "position": [
        -460,
        -40
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "baseId": "={{$credentials.airtableApi.baseId}}",
        "tableId": "Appointments",
        "id": "={{$json[\"id\"]}}",
        "fields": {
          "ReminderSent": "Yes",
          "ReminderSentAt": "={{$now}}"
        }
      },
      "id": "84543f92-97fe-4e0f-8cd8-5470619eceb8",
      "name": "Mark Reminder Sent",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        -200,
        -40
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "baseId": "={{$credentials.airtableApi.baseId}}",
        "tableId": "Appointments",
        "filterByFormula": "=AND({StartTime}<=NOW(), {NoShow}='Yes', {RecoverySent}='No')"
      },
      "id": "7fe7c087-cf3d-4102-8197-bacc5d0945b9",
      "name": "Find No-Show Appointments",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        -720,
        220
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "={{$credentials.twilioApi.fromNumber}}",
        "to": "={{$json[\"Phone\"]}}",
        "message": "We missed you at {{$json[\"BusinessName\"]}} today. Reply here to reschedule and we will prioritize your new slot."
      },
      "id": "e54fdf93-413f-4fd8-af93-6f0f98850a36",
      "name": "Send No-Show Recovery SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 2,
      "position": [
        -460,
        160
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "={{$credentials.twilioApi.fromNumber}}",
        "to": "={{$json[\"OwnerPhone\"]}}",
        "message": "No-show alert: {{$json[\"CustomerName\"]}} missed {{$json[\"StartTime\"]}}. Recovery SMS sent automatically."
      },
      "id": "d7e1c968-35cc-465d-baea-c2bc9cca2688",
      "name": "Notify Owner of No-Show",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 2,
      "position": [
        -200,
        160
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "baseId": "={{$credentials.airtableApi.baseId}}",
        "tableId": "Appointments",
        "id": "={{$json[\"id\"]}}",
        "fields": {
          "RecoverySent": "Yes",
          "RecoverySentAt": "={{$now}}"
        }
      },
      "id": "ec8a3ef3-4615-4b01-a68f-9e8f68bcb312",
      "name": "Mark Recovery Sent",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        60,
        160
      ]
    }
  ],
  "connections": {
    "Hourly Trigger": {
      "main": [
        [
          {
            "node": "Find Upcoming Appointments",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Find No-Show Appointments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Upcoming Appointments": {
      "main": [
        [
          {
            "node": "Send Reminder SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Reminder SMS": {
      "main": [
        [
          {
            "node": "Mark Reminder Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find No-Show Appointments": {
      "main": [
        [
          {
            "node": "Send No-Show Recovery SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send No-Show Recovery SMS": {
      "main": [
        [
          {
            "node": "Notify Owner of No-Show",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Owner of No-Show": {
      "main": [
        [
          {
            "node": "Mark Recovery Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "f651bdc6-fb69-4844-a0dc-80456d089c69"
}
