{
  "name": "Missed Call Text-Back + Lead Capture (San Antonio)",
  "nodes": [
    {
      "parameters": {
        "path": "twilio-missed-call",
        "method": "POST",
        "responseMode": "responseNode"
      },
      "id": "1c8dfe57-918a-43e1-a8d2-aef113cbbe7b",
      "name": "Twilio Voice Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -700,
        20
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "callerNumber",
              "value": "={{$json[\"From\"] || $json[\"from\"]}}"
            },
            {
              "name": "businessNumber",
              "value": "={{$json[\"To\"] || $json[\"to\"] || $credentials.twilioApi.fromNumber}}"
            },
            {
              "name": "city",
              "value": "={{$json[\"CallerCity\"] || 'San Antonio'}}"
            },
            {
              "name": "callStatus",
              "value": "={{$json[\"CallStatus\"] || 'no-answer'}}"
            }
          ]
        }
      },
      "id": "a6ec45a4-9bca-46a7-ad69-2e27558f838f",
      "name": "Normalize Call Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        -460,
        20
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "4d4c42f8-2cb2-40fa-8b2a-13f0fe44c53c",
              "leftValue": "={{$json[\"callStatus\"]}}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "f5f0e4b2-d620-4491-b2bc-960ad70da0a8",
      "name": "Was Missed/Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        20
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "from": "={{$json[\"businessNumber\"]}}",
        "to": "={{$json[\"callerNumber\"]}}",
        "message": "Thanks for calling! We missed your call and can still help today. Reply with your name + service needed and our San Antonio team will text you back shortly."
      },
      "id": "ef9f2ca8-ce79-457b-a78a-d0f07a472388",
      "name": "Send Instant Text-Back",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 2,
      "position": [
        40,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "baseId": "={{$credentials.airtableApi.baseId}}",
        "tableId": "MissedCalls",
        "fields": {
          "Phone": "={{$json[\"callerNumber\"]}}",
          "City": "={{$json[\"city\"]}}",
          "Status": "New",
          "CallStatus": "={{$json[\"callStatus\"]}}",
          "Source": "Twilio Voice"
        }
      },
      "id": "15846cf3-8588-4723-8a2f-1302e7f63547",
      "name": "Log Missed Call (Airtable)",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [
        300,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"ok\": true, \"status\": \"captured\", \"phone\": $json[\"callerNumber\"], \"callStatus\": $json[\"callStatus\"] } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "9862fe4f-3f2e-4d35-8db0-0f16a2f89f4d",
      "name": "Webhook Response (Captured)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        560,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"ok\": true, \"status\": \"ignored\", \"reason\": \"not-a-missed-call-event\" } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "0ce32496-8069-4869-a11a-733283161fc1",
      "name": "Webhook Response (Ignored)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        40,
        140
      ]
    }
  ],
  "connections": {
    "Twilio Voice Webhook": {
      "main": [
        [
          {
            "node": "Normalize Call Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Call Payload": {
      "main": [
        [
          {
            "node": "Was Missed/Completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Was Missed/Completed?": {
      "main": [
        [
          {
            "node": "Send Instant Text-Back",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Webhook Response (Ignored)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Instant Text-Back": {
      "main": [
        [
          {
            "node": "Log Missed Call (Airtable)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Missed Call (Airtable)": {
      "main": [
        [
          {
            "node": "Webhook Response (Captured)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "55637d1f-8f2d-4891-8d47-a8f23f5b5de4"
}
